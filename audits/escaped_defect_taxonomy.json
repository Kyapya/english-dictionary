{
  "schema_version": "escaped_defect_taxonomy_v1",
  "categories": [
    {
      "id": "compound_component_generalization",
      "description": "複合語の一要素の性質を、複合語全体または見出し語の一般則として広げる誤り。",
      "expected_detection_stages": ["qualification", "sense-structure"]
    },
    {
      "id": "argument_slot_role_mismatch",
      "description": "文法フレームの項スロットと、用例内で実現している意味役割が一致しない誤り。",
      "expected_detection_stages": ["frame-relation", "example-attribution"]
    },
    {
      "id": "regional_qualification",
      "description": "地域差・方言差・英米差の限定が不足、過剰、または根拠不十分である誤り。",
      "expected_detection_stages": ["qualification"]
    },
    {
      "id": "technical_terminology_conventionality",
      "description": "専門領域・制度内で慣用される訳語、用法、範囲を一般語の直訳で置き換える誤り。",
      "expected_detection_stages": ["qualification", "evidence"]
    },
    {
      "id": "sense_boundary_overlap",
      "description": "語義間の最小差が示されず、重複・分割・統合の判断が不安定になる誤り。",
      "expected_detection_stages": ["sense-structure"]
    },
    {
      "id": "lexical_relation_mislabel",
      "description": "対照表現・関連語を、同一軸上の反意語または十分近い類義語として誤表示する誤り。",
      "expected_detection_stages": ["frame-relation"]
    },
    {
      "id": "example_translation_alignment",
      "description": "英文と訳文で意味役割、修飾範囲、程度、時制、レジスターが保存されない誤り。",
      "expected_detection_stages": ["translation"]
    },
    {
      "id": "example_sense_attribution_mismatch",
      "description": "見出し語の例文が所属語義として解釈できない、別語義として読む方が自然、または複数語義で同程度に自然なのに判別語がない誤り。",
      "expected_detection_stages": ["example-attribution"]
    },
    {
      "id": "absolute_scope_counterexample",
      "description": "必ず・のみ・不可などの絶対表現に対する反例探索が不足する誤り。",
      "expected_detection_stages": ["qualification"]
    },
    {
      "id": "pronunciation_symbol_explanation",
      "description": "発音記号、地域変種、発音説明の対応が曖昧または矛盾する誤り。",
      "expected_detection_stages": ["pronunciation"]
    },
    {
      "id": "evidence_claim_mismatch",
      "description": "出典位置や適用範囲が対象主張を直接支えず、一般的な出典名だけで根拠化する誤り。",
      "expected_detection_stages": ["evidence"]
    },
    {
      "id": "semantic_direction_reversal",
      "description": "作用する側／される側、上位／下位、原因／結果など、意味関係の方向を逆転させる誤り。",
      "expected_detection_stages": ["sense-structure", "frame-relation"]
    },
    {
      "id": "cross_section_internal_contradiction",
      "description": "コアイメージ、語義見出し、定義、語法、類義語など別セクション間で同じ概念の範囲・関係が食い違う誤り。",
      "expected_detection_stages": ["sense-structure", "frame-relation"]
    },
    {
      "id": "finding_scope_transfer_loss",
      "description": "レビューfindingが複数箇所を指摘したのに、resolution・修正・最終確認へ一部の対象しか引き継がれない誤り。",
      "expected_detection_stages": ["final-review"]
    },
    {
      "id": "raw_adjudication_manifest_divergence",
      "description": "レビュー原出力に存在しない個別判定・意味制約・確認結果が監査マニフェストへ後付けされる誤り。",
      "expected_detection_stages": ["final-review"]
    }
  ]
}
