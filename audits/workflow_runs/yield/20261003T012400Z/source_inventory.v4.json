        "accessed_at": "2026-10-03",
        "facts": [
          {
            "id": "MW-YIELD-1",
            "statement": "Production, investment profit, surrender of control, yielding oneself, precedence, baseball hit/run, intransitive floor, physical yielding, inferior-to-none, succession and productivity.",
