          },
          {
            "id": "MW-YIELD-3",
            "statement": "Dictionary-authored examples include bond annual yield and senator yielding the floor; no exclusivity to a particular legislature claimed.",
            "source_detail": "Publisher entry; paraphrased lexical evidence, not proof of every original example or numerical frequency."
          }
        ]
