  "source_first_audit": {
    "sources": [
      {
        "id": "mw-yield",
        "source_type": "general_dictionary",
        "independence_group": "merriam_webster",
        "locator": "https://www.merriam-webster.com/dictionary/yield",
        "facts": [
          {
            "id": "mw-production",
            "statement": "Transitive yield covers natural produce, results, investment income and revenue."
          },
          {
            "id": "mw-surrender",
            "statement": "Yield covers surrender of control, reflexive surrender of oneself, submission and yielding a legislative floor."
          },
          {
            "id": "mw-physical",
            "statement": "Physical yielding includes bending, stretching or breaking under force."
          },
          {
            "id": "mw-replacement",
            "statement": "Yield can mean give precedence, be inferior, or become succeeded by something else."
          },
          {
            "id": "mw-baseball",
            "statement": "A pitcher may yield hits or runs."
          },
          {
            "id": "mw-noun",
            "statement": "Noun yield denotes a product or amount returned; it can also denote productive capacity."
          },
          {
            "id": "mw-etymology",
            "statement": "Middle English derives from Old English gieldan, cognate with Old High German geltan, meaning pay."
          }
        ]
      },
      {
        "id": "collins-yield",
        "source_type": "learner_dictionary",
        "independence_group": "harpercollins",
        "locator": "https://www.collinsdictionary.com/dictionary/english/yield",
        "facts": [
          {
            "id": "collins-senses",
            "statement": "COBUILD records surrender, replacement, US traffic precedence, physical movement, production, revenue and noun amount/financial return."
          },
          {
            "id": "collins-frames",
            "statement": "Yield takes direct objects for control and produce; yield to can introduce pressure or a successor; productive intransitive use also exists."
          },
          {
            "id": "collins-phonology",
            "statement": "Pronunciation is /jiːld/; forms are yields, yielding and yielded."
          },
          {
            "id": "collins-special",
            "statement": "Noun uses include chemical reaction yield and nuclear explosive energy."
          },
          {
            "id": "collins-up",
            "statement": "Yield up occurs both for relinquishing control and furnishing produce."
          }
        ]
      },
      {
        "id": "cambridge-yield",
        "source_type": "learner_dictionary",
        "independence_group": "cambridge",
        "locator": "https://dictionary.cambridge.org/us/dictionary/english/yield?topic=creating-and-producing",
        "facts": [
          {
            "id": "cambridge-production",
            "statement": "Production examples include unexpected results and poor sound quality; a positive outcome is not required."
          },
          {
            "id": "cambridge-frames",
            "statement": "Surrender may be intransitive or transitive, optionally with up."
          }
        ]
      },
