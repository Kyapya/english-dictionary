      "section": "＃意味・用法・関連表現",
      "sense": "2. 【他動詞】考慮から除外する",
      "text_sha256": "c313a9a949ce74cc2d58db7a234842aa7f7d782d73ad9f7c2d45b0c874823eab",
      "requires_evidence": true,
      "evidence_policy": "two_sources_or_primary",
      "text": "一般語。調査、診断、推論、採用・選考、意思決定などの説明で多い。"
    },
    {
      "id": "grammar_pattern:005",
      "kind": "grammar_pattern",
      "location": "line:127",
      "section": "＃意味・用法・関連表現",
      "sense": "2. 【他動詞】考慮から除外する",
      "text_sha256": "4fc8f20ef1ff0556a0b2039645da7805c48da0e704ce16aeb5b9430c9c261c59",
      "requires_evidence": true,
      "evidence_policy": "one_source",
      "text": "`eliminate 〈人・物〉 from consideration/investigation/the shortlist`＝〈人・物〉を考慮・調査・候補から外す"
    },
    {
      "id": "grammar_pattern:006",
      "kind": "grammar_pattern",
      "location": "line:127",
      "section": "＃意味・用法・関連表現",
      "sense": "2. 【他動詞】考慮から除外する",
      "text_sha256": "a7770de4eedba2b343f3038313df630c7cd7f7682ce45ebae0e004a173039f51",
